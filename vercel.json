{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/styles/(.*)", "destination": "/frontend/styles/$1" },
    { "source": "/scripts/(.*)", "destination": "/frontend/scripts/$1" },
    { "source": "/styles/style.css", "destination": "/frontend/styles/style.css" },
    { "source": "/scripts/signup.js", "destination": "/frontend/scripts/signup.js" },
    { "source": "/(.*)", "destination": "/frontend/public/$1" }
  ]
}
